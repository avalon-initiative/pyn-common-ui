{
  "name": "@avalon-initiative/pyn-common-ui",
  "version": "0.1.19",
  "description": "Shared Vue 3 component library for pyn's web clients, developed and documented in Storybook.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avalon-initiative/pyn-common-ui.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./global.css": "./dist/global.css"
  },
  "scripts": {
    "build": "vite build && npm run build:types && npm run build:assets",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:assets": "cp src/styles/tokens.css src/styles/global.css dist/",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/vue3": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.3"
  },
  "overrides": {
    "minimatch": "^11.0.8",
    "glob": "^14.0.6"
  }
}
